#!/usr/bin/env bash
# git for the mail node tests: the commit of the mailcow checkout is MOCK_GIT_HEAD (none: not a
# git checkout), its tag MOCK_GIT_DESCRIBE, the files it tracks MOCK_GIT_TRACKED (one per line,
# relative to the checkout; ls-files prints them all, whatever the pathspec).
case "$*" in
  *"rev-parse --is-inside-work-tree"*) [ -n "${MOCK_GIT_HEAD:-}" ] || exit 128 && echo true ;;
  *ls-files*)
    [ -n "${MOCK_GIT_HEAD:-}" ] || exit 128
    if [ -n "${MOCK_GIT_TRACKED:-}" ]; then printf '%s\n' "$MOCK_GIT_TRACKED" | tr '\n' '\0'; fi
    ;;
  *"rev-parse HEAD"*) [ -n "${MOCK_GIT_HEAD:-}" ] || exit 128 && echo "$MOCK_GIT_HEAD" ;;
  *describe*) [ -n "${MOCK_GIT_HEAD:-}" ] || exit 128 && echo "${MOCK_GIT_DESCRIBE:-2026-09}" ;;
  *) exit 1 ;;
esac
