# MailExpert mail node backup (scripts/deploy/mail-node/setup.sh, once the restic keys are stored):
# every night at 02:30. Used only on a host without systemd. Failures go to the Healthchecks ping
# (NODE_BACKUP_PING_URL), not mail.
MAILTO=""
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 2 * * * root @DIR@/node-backup.sh
