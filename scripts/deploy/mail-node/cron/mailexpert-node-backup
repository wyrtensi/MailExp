# MailExpert mail node backup (scripts/deploy/mail-node/setup.sh, once the restic keys are stored):
# every night at 02:30. Used only on a host without systemd. The whole run is bounded by timeout
# (the sum of node.env's bounds; -k: SIGKILL a minute later), the next run removes the containers a
# killed one left. Output goes to @LOG@ (rotated by logrotate), failures to the Healthchecks ping
# (NODE_BACKUP_PING_URL), not mail.
MAILTO=""
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 2 * * * root timeout -k 60 @TIMEOUT@ @DIR@/node-backup.sh >>@LOG@ 2>&1
