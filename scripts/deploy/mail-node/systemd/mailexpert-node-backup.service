[Unit]
Description=MailExpert: mail node backup (mailcow dump and vmail to restic)
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=@DIR@/node-backup.sh
# Removes the restic and mailcow backup containers a run killed by the timeout below left running
# (dockerd runs them, not this unit's cgroup).
ExecStopPost=@DIR@/node-backup.sh --cleanup
# Nice and IOSchedulingClass apply to the script and the docker client only: the containers that do
# the work (mailcow's dump, restic) run under dockerd and keep their default priority.
Nice=10
IOSchedulingClass=idle
# The sum of the run's own bounds (NODE_BACKUP_DUMP_TIMEOUT, _PUSH_, _VERIFY_, retention and the
# small calls, node.env) and an hour: setup.sh writes it. Each phase stops itself first, with its
# own message and a /fail ping.
TimeoutStartSec=@TIMEOUT@
