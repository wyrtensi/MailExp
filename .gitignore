# Environment — never commit real secrets
.env
*.env.local

# Local docker compose overrides (e.g. temporary LOG_LEVEL=debug for a soak) — never committed
docker-compose.override.yml

# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/.vite/
frontend/packages/release/

# TLS certs (generated locally or via Let's Encrypt)
certs/
# The Microsoft tenant application certificate (PFX) and its password: never committed
tenant-cert/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

.superpowers/
output/

# Local secrets for manual setup (e.g. a Google Cloud OAuth client file) - never committed
/data/
